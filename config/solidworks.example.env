# Copy to solidworks.local.env (ignored). Literal KEY=VALUE; no shell expansion.
# Relative paths resolve against this repository root. Leave unknown values empty.
SOLIDWORKS_MCP_PATH=
PYTHON_EXECUTABLE=
CASES_PATH=
SOLIDWORKS_MCP_EXECUTABLE=
SOLIDWORKS_EXE=
SOLIDWORKS_VERSION=
CODEX_MCP_CONFIG=
# Upstream variables: configure these separately in Codex TOML too.
SW_MCP_OUTPUT_ROOT=
SW_MCP_TEMPLATE_DIR=
# Smoke test creates a new, unique subdirectory here; use a disposable output folder.
SMOKE_OUTPUT_ROOT=
