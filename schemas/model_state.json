{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelState",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_name": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "drawing_analysis",
        "planning",
        "modeling",
        "modeling_complete",
        "evaluation",
        "evaluated"
      ]
    },
    "active_document": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_type": {
      "const": "SLDPRT"
    },
    "units": {
      "const": "mm"
    },
    "completed_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "failed_features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason",
          "suggested_fix"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "feature_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "rebuild_status": {
      "enum": [
        "PASS",
        "NEEDS_FIX",
        "FAILED",
        "NOT_CHECKED"
      ]
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "verification_results": {
      "$ref": "#/$defs/verification"
    },
    "generated_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "modeling_completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "ground_truth_access": {
      "enum": [
        "locked",
        "allowed"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_name",
    "phase",
    "active_document",
    "document_type",
    "units",
    "completed_features",
    "failed_features",
    "unresolved",
    "feature_bindings",
    "rebuild_status",
    "measurements",
    "verification_results",
    "generated_path",
    "generated_sha256",
    "modeling_completed_at",
    "ground_truth_access"
  ],
  "additionalProperties": false,
  "$defs": {
    "issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question",
        "affected_ids",
        "blocking"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "NEEDS_FIX",
            "FAILED",
            "NOT_CHECKED"
          ]
        },
        "expected": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "actual": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target_id",
        "status",
        "expected",
        "actual",
        "unit",
        "evidence",
        "reason"
      ],
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "properties": {
        "feature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "actual": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "feature_id",
        "expected",
        "actual",
        "reason",
        "suggested_fix"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "NEEDS_FIX",
            "FAILED"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/problem"
          }
        }
      },
      "required": [
        "status",
        "checks",
        "problems"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "const": "PASS"
                    },
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              },
              "problems": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NEEDS_FIX",
                  "FAILED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "problems": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "feature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "metric",
        "feature_id",
        "value",
        "unit",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ground_truth_access": {
            "const": "allowed"
          }
        }
      },
      "then": {
        "properties": {
          "generated_path": {
            "type": "string",
            "minLength": 1
          },
          "generated_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "modeling_completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "rebuild_status": {
            "const": "PASS"
          },
          "phase": {
            "enum": [
              "evaluation",
              "evaluated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "modeling_complete",
              "evaluation",
              "evaluated"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "generated_path": {
            "type": "string",
            "minLength": 1
          },
          "generated_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "modeling_completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "rebuild_status": {
            "const": "PASS"
          }
        }
      }
    }
  ]
}
