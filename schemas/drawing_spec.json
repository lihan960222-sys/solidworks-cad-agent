{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DrawingSpec",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "part_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "enum": [
        "mm",
        "inch",
        null
      ]
    },
    "projection": {
      "enum": [
        "first_angle",
        "third_angle",
        "unknown"
      ]
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "details": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "datums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "centerlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "holes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "symmetry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "radii": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "fillets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "chamfers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "ribs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "pockets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "tolerances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schema_version",
    "part_name",
    "units",
    "projection",
    "views",
    "dimensions",
    "sections",
    "details",
    "datums",
    "centerlines",
    "holes",
    "threads",
    "patterns",
    "symmetry",
    "radii",
    "fillets",
    "chamfers",
    "ribs",
    "slots",
    "pockets",
    "tolerances",
    "annotations",
    "facts",
    "inferences",
    "unresolved",
    "confidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "front",
            "top",
            "side",
            "section",
            "detail",
            "auxiliary",
            "isometric",
            "other"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "related_views": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "page",
        "label",
        "related_views",
        "confidence"
      ],
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "length",
            "diameter",
            "radius",
            "angle",
            "ordinate",
            "reference",
            "other"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "mm",
            "inch",
            "deg",
            null
          ]
        },
        "raw_text": {
          "type": "string",
          "minLength": 1
        },
        "source_view": {
          "type": "string",
          "minLength": 1
        },
        "lower_deviation": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper_deviation": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "value",
        "unit",
        "raw_text",
        "source_view",
        "lower_deviation",
        "upper_deviation",
        "confidence"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "fact",
            "inference",
            "unresolved"
          ]
        },
        "source_view": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "description",
        "basis",
        "source_view",
        "source_dimensions",
        "confidence",
        "parameters"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_view": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "statement",
        "source_view",
        "source_dimensions",
        "confidence"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_view": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "statement",
        "source_view",
        "source_dimensions",
        "confidence",
        "reasoning",
        "approved"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question",
        "affected_ids",
        "blocking"
      ],
      "additionalProperties": false
    }
  }
}
