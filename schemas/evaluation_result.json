{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationResult",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_name": {
      "type": "string",
      "minLength": 1
    },
    "overall_status": {
      "enum": [
        "PASS",
        "NEEDS_FIX",
        "FAILED"
      ]
    },
    "generated_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "comparison_frame": {
      "type": "string",
      "minLength": 1
    },
    "bounding_box_error": {
      "type": "object",
      "properties": {
        "x_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "y_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "z_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "x_mm",
        "y_mm",
        "z_mm"
      ],
      "additionalProperties": false
    },
    "volume_error_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "surface_area_error_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "center_of_mass_error": {
      "type": "object",
      "properties": {
        "x_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "y_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "z_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "norm_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "x_mm",
        "y_mm",
        "z_mm",
        "norm_mm"
      ],
      "additionalProperties": false
    },
    "critical_dimension_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "feature_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "geometry_check": {
      "$ref": "#/$defs/geometry"
    },
    "visual_check": {
      "enum": [
        "PASS",
        "NEEDS_FIX",
        "NOT_CHECKED"
      ]
    },
    "missing_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "case_name",
    "overall_status",
    "generated_sha256",
    "original_sha256",
    "evaluated_at",
    "comparison_frame",
    "bounding_box_error",
    "volume_error_percent",
    "surface_area_error_percent",
    "center_of_mass_error",
    "critical_dimension_results",
    "feature_results",
    "geometry_check",
    "visual_check",
    "missing_checks",
    "notes"
  ],
  "additionalProperties": false,
  "$defs": {
    "comparison": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "actual": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "absolute_tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "enum": [
            "PASS",
            "NEEDS_FIX",
            "NOT_CHECKED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "expected",
        "actual",
        "unit",
        "absolute_tolerance",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "not_performed",
            "solid_difference",
            "step_geometry",
            "validated_geometric_comparison"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "NEEDS_FIX",
            "NOT_CHECKED"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "method",
        "status",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "missing_checks": {
            "maxItems": 0
          },
          "geometry_check": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "method": {
                "not": {
                  "const": "not_performed"
                }
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "critical_dimension_results": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                },
                "expected": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "actual": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "absolute_tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "feature_results": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                },
                "expected": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "actual": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "absolute_tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "volume_error_percent": {
            "type": "number",
            "minimum": 0
          },
          "surface_area_error_percent": {
            "type": "number",
            "minimum": 0
          },
          "bounding_box_error": {
            "properties": {
              "x_mm": {
                "type": "number",
                "minimum": 0
              },
              "y_mm": {
                "type": "number",
                "minimum": 0
              },
              "z_mm": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "center_of_mass_error": {
            "properties": {
              "x_mm": {
                "type": "number",
                "minimum": 0
              },
              "y_mm": {
                "type": "number",
                "minimum": 0
              },
              "z_mm": {
                "type": "number",
                "minimum": 0
              },
              "norm_mm": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ]
}
