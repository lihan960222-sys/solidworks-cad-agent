{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeaturePlan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "part_name": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "const": "SLDPRT"
    },
    "units": {
      "const": "mm"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "verification_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "required": [
    "schema_version",
    "part_name",
    "document_type",
    "units",
    "features",
    "verification_targets",
    "assumptions",
    "unresolved"
  ],
  "additionalProperties": false,
  "$defs": {
    "feature": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "reference_plane",
            "reference_axis",
            "sketch",
            "boss_extrude",
            "cut_extrude",
            "revolve",
            "revolved_cut",
            "hole",
            "counterbore",
            "countersink",
            "slot",
            "rib",
            "shell",
            "linear_pattern",
            "circular_pattern",
            "mirror",
            "fillet",
            "chamfer",
            "sweep",
            "loft"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sketch_plane": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "source_view": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      },
      "required": [
        "id",
        "type",
        "depends_on",
        "sketch_plane",
        "parameters",
        "source_view",
        "source_dimensions",
        "confidence",
        "verification_targets"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "absolute_tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "metric",
        "expected",
        "unit",
        "absolute_tolerance",
        "source_dimensions",
        "required"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_view": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "statement",
        "source_view",
        "source_dimensions",
        "confidence",
        "reasoning",
        "approved"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question",
        "affected_ids",
        "blocking"
      ],
      "additionalProperties": false
    }
  }
}
